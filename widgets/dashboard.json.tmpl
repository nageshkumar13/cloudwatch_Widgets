    {
      "type": "metric",
      "x": 0,
      "y": 14,
      "width": 8,
      "height": 7,
      "properties": {
        "metrics": [
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"RequestCount\" ', 'Sum', 300)",
              "region": "us-east-1",
              "visible": false
            }
          ],
          [
            "AWS/ApplicationELB",
            "RequestCount",
            "LoadBalancer",
            "${ecs_lb}",
            { "id": "m1" }
          ]
        ],
        "legend": { "position": "bottom" },
        "title": "RequestCount: Sum",
        "region": "us-east-1",
        "liveData": false,
        "timezone": "UTC",
        "view": "timeSeries",
        "stacked": false,
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 14,
      "width": 8,
      "height": 7,
      "properties": {
        "metrics": [
          [
            {
              "id": "expr1m11",
              "label": "${ecs_cluster}",
              "expression": "mm0m11",
              "region": "us-east-1"
            }
          ],
          [
            "ECS/ContainerInsights",
            "TaskCount",
            "ClusterName",
            "structured-logs-regain",
            {
              "period": 60,
              "stat": "Average",
              "id": "mm0m0",
              "visible": false,
              "region": "us-east-1"
            }
          ],
          [
            "...",
            "${ecs_cluster}",
            {
              "period": 60,
              "stat": "Average",
              "id": "mm0m11",
              "visible": false,
              "region": "us-east-1"
            }
          ]
        ],
        "legend": { "position": "bottom" },
        "title": "Task Count",
        "yAxis": {
          "left": { "showUnits": false, "label": "Count" }
        },
        "region": "us-east-1",
        "liveData": false,
        "view": "timeSeries",
        "stacked": false
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 14,
      "width": 8,
      "height": 7,
      "properties": {
        "metrics": [
          [
            {
              "expression": "100 * (1 - FILL(m1,0) / FILL(m2,1))",
              "label": "Availability %",
              "id": "e1",
              "region": "us-east-1"
            }
          ],
          [
            "AWS/ApplicationELB",
            "HTTPCode_ELB_5XX_Count",
            "LoadBalancer",
            "${ecs_lb}",
            { "region": "us-east-1", "id": "m1", "visible": false }
          ],
          [
            ".",
            "RequestCount",
            ".",
            ".",
            { "region": "us-east-1", "id": "m2", "visible": false }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 60,
        "title": "Availability %"
      }
    },

