    {
      "type": "metric",
      "x": 0,
      "y": 35,
      "width": 12,
      "height": 7,
      "properties": {
        "region": "us-east-1",
        "title": "Task Count",
        "legend": { "position": "bottom" },
        "timezone": "LOCAL",
        "metrics": [
          [
            "ECS/ContainerInsights",
            "TaskCount",
            "ClusterName",
            "${ecs_cluster}",
            { "id": "taskCountm0", "stat": "Sum", "visible": false, "accountId": "${aws_acc_id}" }
          ],
          [
            {
              "label": "Total running tasks (count)",
              "color": "#2ca02c",
              "expression": "IF(PERIOD(taskCountm0)>=60, taskCountm0/(PERIOD(taskCountm0)/60), taskCountm0)",
              "accountId": "${aws_acc_id}"
            }
          ],
          [
            {
              "id": "expr2m0",
              "label": "Pending service tasks (count)",
              "color": "#ff7f0e",
              "expression": "SUM(SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName} PendingTaskCount ClusterName=\"${ecs_cluster}\"', 'Average', 300))",
              "stat": "Average",
              "accountId": "${aws_acc_id}"
            }
          ]
        ],
        "liveData": false,
        "period": 60,
        "view": "singleValue"
      }
    },
