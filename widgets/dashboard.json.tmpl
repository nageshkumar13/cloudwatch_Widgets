{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 7,
      "properties": {
        "title": "CloudFront Requests",
        "view": "timeSeries",
        "region": "us-east-1",
        "period": 60,
        "stat": "Sum",
        "metrics": [
          [
            "AWS/CloudFront",
            "Requests",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 0,
      "width": 6,
      "height": 7,
      "properties": {
        "title": "CloudFront Error Rate (%)",
        "view": "timeSeries",
        "region": "us-east-1",
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "AWS/CloudFront",
            "4xxErrorRate",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global"
          ],
          [
            "AWS/CloudFront",
            "5xxErrorRate",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 6,
      "height": 7,
      "properties": {
        "title": "CloudFront Cache Hit Rate (%)",
        "view": "singleValue",
        "region": "us-east-1",
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/CloudFront",
            "CacheHitRate",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 0,
      "width": 6,
      "height": 7,
      "properties": {
        "title": "CloudFront Origin Latency (p95 / p99)",
        "view": "timeSeries",
        "region": "us-east-1",
        "period": 60,
        "metrics": [
          [
            "AWS/CloudFront",
            "OriginLatency",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global",
            { "stat": "p95", "label": "p95" }
          ],
          [
            "AWS/CloudFront",
            "OriginLatency",
            "DistributionId",
            "${cloudfront_distribution_id}",
            "Region",
            "Global",
            { "stat": "p99", "label": "p99" }
          ]
        ]
      }
    },

